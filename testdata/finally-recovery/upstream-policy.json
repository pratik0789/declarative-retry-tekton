{
  "apiVersion": "retry.tekton.dev/v1alpha1",
  "kind": "PipelineRetryPolicy",
  "metadata": {
    "name": "upstream"
  },
  "spec": {
    "pipelineRef": "finally-recovery",
    "tasks": {
      "notify": {
        "retryWith": [
          "build"
        ]
      },
      "build": {
        "retryWith": [
          "prepare"
        ]
      }
    }
  }
}
