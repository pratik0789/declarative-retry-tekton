{
  "apiVersion": "tekton.dev/v1",
  "kind": "PipelineRun",
  "metadata": {
    "annotations": {
      "retry.tekton.dev/inherited-taskruns": "observe=fi-5-source-observe",
      "retry.tekton.dev/policy": "fi-5-closure-policy",
      "retry.tekton.dev/policy-generation": "1",
      "retry.tekton.dev/source-pipeline": "fi-5",
      "retry.tekton.dev/source-pipeline-run": "fi-5-source",
      "retry.tekton.dev/source-pipeline-run-uid": "73da1546-4010-4930-b579-bc78b4622683"
    },
    "namespace": "retry-direction-20261025-r1",
    "name": "fi-5-closure-recovery"
  },
  "spec": {
    "pipelineSpec": {
      "tasks": [
        {
          "name": "prepare",
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nprintf \"input:$(context.pipelineRun.name):695603ff201a8586\" > $(workspaces.data.path)/source.txt\nrm -f $(workspaces.data.path)/receipt.txt\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "build",
          "runAfter": [
            "prepare"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nsha256sum $(workspaces.data.path)/source.txt | cut -d\" \" -f1 | tr -d \"\\n\" > $(workspaces.data.path)/artifact-input.sha\nprintf \"built:\" > $(workspaces.data.path)/artifact.txt; cat $(workspaces.data.path)/artifact-input.sha >> $(workspaces.data.path)/artifact.txt\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "gate",
          "runAfter": [
            "build"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\ncase \"$(context.pipelineRun.name)\" in *-source) echo INJECTED-GATE-FAILURE; exit 1;; esac\necho GATE-PASSED\n"
              }
            ]
          }
        },
        {
          "name": "publish",
          "runAfter": [
            "gate"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nactual=`sha256sum $(workspaces.data.path)/source.txt | cut -d\" \" -f1`\nrecorded=`cat $(workspaces.data.path)/artifact-input.sha`\nif [ \"$actual\" != \"$recorded\" ]; then echo STALE-ARTIFACT; exit 1; fi\nif [ \"`cat $(workspaces.data.path)/artifact.txt`\" != \"built:$actual\" ]; then echo BAD-ARTIFACT; exit 1; fi\nartifact=`sha256sum $(workspaces.data.path)/artifact.txt | cut -d\" \" -f1`\nprintf \"%s %s\" \"$actual\" \"$artifact\" > $(workspaces.data.path)/receipt.txt\necho ORACLE-CONSISTENT\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        }
      ],
      "workspaces": [
        {
          "name": "shared"
        }
      ]
    },
    "taskRunTemplate": {
      "serviceAccountName": "default"
    },
    "timeouts": {
      "pipeline": "1h0m0s"
    },
    "workspaces": [
      {
        "name": "shared",
        "persistentVolumeClaim": {
          "claimName": "fi-5-closure"
        }
      }
    ]
  }
}
