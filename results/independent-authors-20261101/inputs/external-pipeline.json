{
 "apiVersion": "tekton.dev/v1",
 "kind": "Pipeline",
 "metadata": {
  "name": "external-recovery"
 },
 "spec": {
  "tasks": [
   {
    "name": "warmup",
    "taskSpec": {
     "metadata": {},
     "spec": null,
     "steps": [
      {
       "computeResources": {},
       "image": "alpine:3.20",
       "name": "execute",
       "script": "#!/bin/sh\nset -eu\necho warmed\n"
      }
     ]
    }
   },
   {
    "name": "acquire",
    "runAfter": [
     "warmup"
    ],
    "taskSpec": {
     "metadata": {},
     "spec": null,
     "steps": [
      {
       "computeResources": {},
       "image": "alpine:3.20",
       "name": "execute",
       "script": "#!/bin/sh\nset -eu\nwget -q -O- --post-data='{}' http://oracle:8000/execute/acquire\n"
      }
     ]
    }
   },
   {
    "name": "publish",
    "runAfter": [
     "acquire"
    ],
    "taskSpec": {
     "metadata": {},
     "spec": null,
     "steps": [
      {
       "computeResources": {},
       "image": "alpine:3.20",
       "name": "execute",
       "script": "#!/bin/sh\nset -eu\nwget -q -O- --post-data='{}' http://oracle:8000/execute/publish\n"
      }
     ]
    }
   },
   {
    "name": "sign",
    "runAfter": [
     "publish"
    ],
    "taskSpec": {
     "metadata": {},
     "spec": null,
     "steps": [
      {
       "computeResources": {},
       "image": "alpine:3.20",
       "name": "execute",
       "script": "#!/bin/sh\nset -eu\nwget -q -O- --post-data='{}' http://oracle:8000/execute/sign\n"
      }
     ]
    }
   },
   {
    "name": "scan",
    "runAfter": [
     "sign"
    ],
    "taskSpec": {
     "metadata": {},
     "spec": null,
     "steps": [
      {
       "computeResources": {},
       "image": "alpine:3.20",
       "name": "execute",
       "script": "#!/bin/sh\nset -eu\nwget -q -O- --post-data='{}' http://oracle:8000/execute/scan\n"
      }
     ]
    }
   },
   {
    "name": "deploy",
    "runAfter": [
     "scan"
    ],
    "taskSpec": {
     "metadata": {},
     "spec": null,
     "steps": [
      {
       "computeResources": {},
       "image": "alpine:3.20",
       "name": "execute",
       "script": "#!/bin/sh\nset -eu\nwget -q -O- --post-data='{}' http://oracle:8000/execute/deploy\n"
      }
     ]
    }
   }
  ]
 }
}