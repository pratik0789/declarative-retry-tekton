{
  "apiVersion": "tekton.dev/v1",
  "kind": "PipelineRun",
  "metadata": {
    "annotations": {
      "retry.tekton.dev/inherited-taskruns": "observe=pw-5-source-observe",
      "retry.tekton.dev/policy": "pw-5-closure-policy",
      "retry.tekton.dev/policy-generation": "1",
      "retry.tekton.dev/source-pipeline": "pw-5",
      "retry.tekton.dev/source-pipeline-run": "pw-5-source",
      "retry.tekton.dev/source-pipeline-run-uid": "83f311a5-aa90-4c9d-b3cf-00cced4e45de"
    },
    "namespace": "retry-closure-20261011-1e62",
    "name": "pw-5-closure-recovery"
  },
  "spec": {
    "pipelineSpec": {
      "tasks": [
        {
          "name": "prepare",
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nprintf \"clean:adde1172ebe12681\" > $(workspaces.data.path)/source.txt\nrm -f $(workspaces.data.path)/artifact.txt $(workspaces.data.path)/artifact-input.sha $(workspaces.data.path)/receipt.txt\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "mutate",
          "runAfter": [
            "prepare"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\ncase \"$(context.pipelineRun.name)\" in *-source) printf \"dirty:adde1172ebe12681\" > $(workspaces.data.path)/source.txt; echo INJECTED-PARTIAL-WRITE; exit 1;; esac\nif [ \"`cat $(workspaces.data.path)/source.txt`\" != \"clean:adde1172ebe12681\" ]; then echo DIRTY-INPUT; exit 1; fi\nsha256sum $(workspaces.data.path)/source.txt | cut -d\" \" -f1 | tr -d \"\\n\" > $(workspaces.data.path)/artifact-input.sha\nprintf \"built:\" > $(workspaces.data.path)/artifact.txt; cat $(workspaces.data.path)/artifact-input.sha >> $(workspaces.data.path)/artifact.txt\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "verify",
          "runAfter": [
            "mutate"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\necho VERIFIED-STAGE\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "publish",
          "runAfter": [
            "verify"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nactual=`sha256sum $(workspaces.data.path)/source.txt | cut -d\" \" -f1`\nrecorded=`cat $(workspaces.data.path)/artifact-input.sha`\nif [ \"$actual\" != \"$recorded\" ]; then echo STALE-ARTIFACT; exit 1; fi\nif [ \"`cat $(workspaces.data.path)/artifact.txt`\" != \"built:$actual\" ]; then echo BAD-ARTIFACT; exit 1; fi\nartifact=`sha256sum $(workspaces.data.path)/artifact.txt | cut -d\" \" -f1`\nprintf \"%s %s\" \"$actual\" \"$artifact\" > $(workspaces.data.path)/receipt.txt\necho ORACLE-CONSISTENT\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        }
      ],
      "workspaces": [
        {
          "name": "shared"
        }
      ]
    },
    "taskRunTemplate": {
      "serviceAccountName": "default"
    },
    "timeouts": {
      "pipeline": "1h0m0s"
    },
    "workspaces": [
      {
        "name": "shared",
        "persistentVolumeClaim": {
          "claimName": "pw-5-closure"
        }
      }
    ]
  }
}
