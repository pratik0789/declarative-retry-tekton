    },
    "namespace": "retry-value-closure-20261030",
    "name": "fi-4-closure-recovery"
  },
  "spec": {
    "pipelineSpec": {
      "tasks": [
        {
          "name": "prepare",
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nprintf \"input:$(context.taskRun.name):0750759f00f2afc8\" > $(workspaces.data.path)/source.txt\nrm -f $(workspaces.data.path)/receipt.txt\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "build",
          "runAfter": [
            "prepare"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nsha256sum $(workspaces.data.path)/source.txt | cut -d\" \" -f1 | tr -d \"\\n\" > $(workspaces.data.path)/artifact-input.sha\nprintf \"built:\" > $(workspaces.data.path)/artifact.txt; cat $(workspaces.data.path)/artifact-input.sha >> $(workspaces.data.path)/artifact.txt\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        },
        {
          "name": "gate",
          "runAfter": [
            "build"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\ncase \"$(context.taskRun.name)\" in *-source-*) echo INJECTED-GATE-FAILURE; exit 1;; esac\necho GATE-PASSED\n"
              }
            ]
          }
        },
        {
          "name": "publish",
          "runAfter": [
            "gate"
          ],
          "taskSpec": {
            "metadata": {},
            "spec": null,
            "steps": [
              {
                "computeResources": {},
                "image": "alpine:3.20",
                "name": "run",
                "script": "set -eu\nactual=`sha256sum $(workspaces.data.path)/source.txt | cut -d\" \" -f1`\nrecorded=`cat $(workspaces.data.path)/artifact-input.sha`\nif [ \"$actual\" != \"$recorded\" ]; then echo STALE-ARTIFACT; exit 1; fi\nif [ \"`cat $(workspaces.data.path)/artifact.txt`\" != \"built:$actual\" ]; then echo BAD-ARTIFACT; exit 1; fi\nartifact=`sha256sum $(workspaces.data.path)/artifact.txt | cut -d\" \" -f1`\nprintf \"%s %s\" \"$actual\" \"$artifact\" > $(workspaces.data.path)/receipt.txt\necho ORACLE-CONSISTENT\n"
              }
            ],
            "workspaces": [
              {
                "name": "data"
              }
            ]
          },
          "workspaces": [
            {
              "name": "data",
              "workspace": "shared"
            }
          ]
        }
      ],
      "workspaces": [
        {
          "name": "shared"
        }
      ]
    },
