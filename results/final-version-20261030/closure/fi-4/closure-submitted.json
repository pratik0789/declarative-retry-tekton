      "retry.tekton.dev/policy": "fi-4-closure-policy",
      "retry.tekton.dev/policy-generation": "1",
      "retry.tekton.dev/policy-spec": "{\"pipelineRef\":\"fi-4\",\"resumeWithin\":\"\",\"retryOnlyLatest\":false,\"tasks\":{\"gate\":{\"blocksResume\":false,\"retryWith\":[\"prepare\",\"build\"]}}}",
      "retry.tekton.dev/policy-spec-sha256": "sha256:be05818a37f9a410165ae04a0893c252d9f69fa0654e0a09785bc9156c5a4c4d",
      "retry.tekton.dev/source-pipeline": "fi-4",
      "retry.tekton.dev/source-pipeline-run": "fi-4-source",
