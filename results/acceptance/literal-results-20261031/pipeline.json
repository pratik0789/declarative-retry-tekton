{
  "apiVersion": "tekton.dev/v1",
  "kind": "Pipeline",
  "metadata": {
    "name": "literal"
  },
  "spec": {
    "tasks": [
      {
        "name": "produce",
        "taskSpec": {
          "results": [
            {
              "name": "out"
            }
          ],
          "steps": [
            {
              "name": "s",
              "image": "alpine:3.20",
              "script": "exit 0"
            }
          ]
        }
      },
      {
        "name": "consume",
        "params": [
          {
            "name": "msg",
            "value": "$(tasks.produce.results.out)"
          }
        ],
        "taskSpec": {
          "params": [
            {
              "name": "msg",
              "type": "string"
            }
          ],
          "steps": [
            {
              "name": "s",
              "image": "alpine:3.20",
              "env": [
                {
                  "name": "MSG",
                  "value": "$(params.msg)"
                }
              ],
              "script": "printf \"%s\" \"$MSG\""
            }
          ]
        }
      }
    ]
  }
}